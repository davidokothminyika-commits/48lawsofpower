<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer. Android tints this by alpha, so only the silhouette is drawn.

  This is a vector rather than a trace of ic_launcher_foreground.png on purpose: the book's
  alpha channel is a solid block, so a traced mask would render as a plain rectangle. The
  page lines below are what make it read as a book once the launcher paints it in one colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M37,24 h32 a3,3 0 0 1 3,3 v56 a3,3 0 0 1 -3,3 h-32 a3,3 0 0 1 -3,-3 v-56 a3,3 0 0 1 3,-3 z M39,38 h28 v4 h-28 z M39,50 h28 v4 h-28 z" />
</vector>
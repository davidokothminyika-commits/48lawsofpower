# Release signing. Copy to keystore.properties and fill in.
#
# keystore.properties is gitignored. The real keystore and its passwords live outside the repo
# at ~/.android/48lawsofpower-release.jks and ~/.android/48lawsofpower-release.properties.
#
# Back both files up somewhere you will not lose them. The signing key is the only thing that
# lets a future build overwrite an already-installed app: if it is lost, users of the installed
# APK cannot upgrade in place, ever. It cannot be regenerated.
#
# If this file is absent, app/build.gradle.kts falls back to debug signing so that a fresh clone
# still builds.
storeFile=/absolute/path/to/keystore.jks
storePassword=
keyAlias=48lawsofpower
keyPassword=